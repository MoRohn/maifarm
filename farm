# CLI commands that should be routed to the farm CLI tool
# Note: Easter egg commands (fart, konami, secrets) are also included but hidden from usage/help
CLI_COMMANDS=("cli" "create" "plant" "list" "ls" "watch" "monitor" "harvest" "reap" "health" "quick" "qt" "wild" "gw" "barn" "stats" "dashboard" "tips" "interactive" "i" "incubate" "fart" "konami" "secrets")

# Check if command is a CLI command
is_cli_command() {
    local cmd="$1"
    for cli_cmd in "${CLI_COMMANDS[@]}"; do
        if [ "$cmd" = "$cli_cmd" ]; then
            return 0
        fi
    done
    return 1
}

# Function to mark initialization as complete
mark_initialized() {
    # Create markers to skip initialization next time
    mkdir -p "$MAIFARM_DIR/maibarn" 2>/dev/null
    mkdir -p "$HOME/.maifarm" 2>/dev/null
    touch "$MAIFARM_DIR/maibarn/.initialized"
    touch "$HOME/.maifarm/initialized"
    echo -e "${GREEN}✓ MaiFarm initialization marked as complete${NC}"
}

# Function to reset initialization (for testing or reinstallation)
reset_initialization() {
    rm -f "$MAIFARM_DIR/maibarn/.initialized"
    rm -f "$HOME/.maifarm/initialized"
    echo -e "${YELLOW}⚠ MaiFarm initialization markers cleared${NC}"
    echo -e "Next time you run 'farm', you'll be guided through setup again."
}

# Main command handler
# Default to 'start' when no command is provided
COMMAND="${1:-start}"

# Route to CLI tool if it's a CLI command
if is_cli_command "$COMMAND"; then
    # Special case: 'farm cli' with no args starts interactive mode
    if [ "$COMMAND" = "cli" ] && [ $# -eq 1 ]; then
        exec node cli/dist/index.js interactive
    elif [ "$COMMAND" = "cli" ]; then
        # 'farm cli <subcommand>' passes the subcommand
        shift
        exec node cli/dist/index.js "$@"
    else
        # Direct command: 'farm create', 'farm list', etc.
        exec node cli/dist/index.js "$@"
    fi
fi

# Otherwise, handle server management commands
case "$COMMAND" in
    start|"")
        start_maifarm
        ;;
    stop)
        stop_maifarm
        ;;
    restart)
        restart_maifarm
        ;;
    status)
        check_status
        ;;
    logs)
        view_logs
        ;;
    build)
        build_production
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo ""
        usage
        exit 1
        ;;
esac
