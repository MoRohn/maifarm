# Production Environment Configuration for MaiFarm
# Copy this file to .env.production and configure with actual values

# Server Configuration
NODE_ENV=production
PORT=4567
HOST=0.0.0.0
TRUST_PROXY=true
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maifarm_production
DB_USER=maifarm
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSL=true
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=60000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IF_USING_AUTH
REDIS_DB=0
REDIS_MAX_RECONNECT=10
REDIS_RECONNECT_DELAY=1000
REDIS_COMMAND_TIMEOUT=5000

# Security Configuration
SESSION_SECRET=CHANGE_ME_RANDOM_STRING_64_CHARS
JWT_SECRET=CHANGE_ME_RANDOM_STRING_64_CHARS
API_KEY_ENCRYPTION_KEY=CHANGE_ME_RANDOM_STRING_32_CHARS
BCRYPT_ROUNDS=12
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
ENABLE_HELMET=true
ENABLE_CSRF=true

# AI Provider Configuration
AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_CONTEXT=200000

# Alternative AI Providers (optional)
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_CONTEXT=128000

# Memory Management
MEMORY_WARNING_THRESHOLD=0.7
MEMORY_CRITICAL_THRESHOLD=0.85
MEMORY_EMERGENCY_THRESHOLD=0.95
MEMORY_MONITOR_INTERVAL=30000
MAX_HEAP_SIZE=8589934592
ENABLE_GC=true

# Logging Configuration
LOG_LEVEL=info
ENABLE_FILE_LOGGING=true
LOG_DIRECTORY=./logs
LOG_MAX_FILE_SIZE=20m
LOG_MAX_FILES=14
ENABLE_ERROR_REPORTING=true
ERROR_REPORTING_ENDPOINT=https://your-error-service.com/api/errors

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=30000
ENABLE_APM=false
APM_SERVICE_NAME=maifarm
ENABLE_TRACING=false

# Performance Configuration
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6
ENABLE_CACHING=true
CACHE_MAX_AGE=3600
ENABLE_CDN=false
CDN_URL=https://cdn.yourdomain.com
REQUEST_TIMEOUT=120000
SHUTDOWN_TIMEOUT=30000

# Farm Configuration
MAX_CONCURRENT_FARMS=10
MAX_AGENTS_PER_FARM=10
FARM_DEFAULT_TIMEOUT=3600
FARM_MAX_TIMEOUT=86400
ENABLE_AUTO_CLEANUP=true
CLEANUP_INTERVAL=300000
FARM_MAX_RETRIES=3

# WebSocket Configuration
WS_MAX_CONNECTIONS=1000
WS_PING_INTERVAL=30000
WS_PING_TIMEOUT=5000
WS_MAX_MESSAGE_SIZE=1048576
WS_ENABLE_COMPRESSION=true
WS_PER_MESSAGE_DEFLATE=true

# Feature Flags
BYPASS_AUTH=false
ENABLE_XENOSYNC=true
ENABLE_GO_WILD=true
ENABLE_QUICK_TASK=true
ENABLE_HARVEST_COLLECTION=true

# External Service URLs (optional)
GRAFANA_URL=http://localhost:3001
PROMETHEUS_URL=http://localhost:9090
ELASTICSEARCH_URL=http://localhost:9200

# Backup Configuration (optional)
ENABLE_BACKUP=true
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# SSL/TLS Configuration (if terminating SSL at app level)
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem
SSL_CA_PATH=/path/to/ca.pem

# Deployment Information
DEPLOYMENT_ID=prod-001
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_ENVIRONMENT=production