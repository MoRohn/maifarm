# Ignore all farm-generated content
# This ensures that farm operations don't affect git

# Ignore all workspace content
workspaces/active/*
workspaces/archived/*

# Ignore all harvest content
harvests/active/*
harvests/completed/*

# Ignore barn items (but keep templates)
barn/items/*
barn/catalog.json

# Ignore coordination files
coordination/farms/*
coordination/locks/*
coordination/active_agents.json

# Ignore all temporary files
temp/*

# Ignore logs (but keep directory)
logs/*

# Keep directory structure markers
!workspaces/active/.gitkeep
!workspaces/archived/.gitkeep
!harvests/active/.gitkeep
!harvests/completed/.gitkeep
!barn/items/.gitkeep
!barn/templates/.gitkeep
!coordination/farms/.gitkeep
!coordination/locks/.gitkeep
!temp/.gitkeep
!logs/.gitkeep
!config/.gitkeep

# Keep documentation
!README.md
!ARCHITECTURE.md
!SECURITY.md
!docs/