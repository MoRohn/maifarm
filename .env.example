# MaiFarm Environment Configuration Template
# Copy this file to .env.development, .env.staging, or .env.production

# Application
NODE_ENV=development
PORT=4567
VITE_API_URL=http://localhost:4567
VITE_WS_URL=ws://localhost:4567

# Authentication
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=7d
BYPASS_AUTH=false

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4567/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4567/api/auth/github/callback

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maifarm
DB_USER=maifarm
DB_PASSWORD=maifarm_password
DB_POOL_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# WebSocket
WS_PORT=4567
WS_PATH=/socket.io

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# AI Providers
AI_PROVIDER=claude # Options: claude, qwen

# Claude Configuration
CLAUDE_API_KEY=
CLAUDE_API_ENDPOINT=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-3-sonnet-20240229

# Qwen3-Coder Configuration
QWEN_ENABLED=false
QWEN_API_KEY=
QWEN_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen-coder-480b
QWEN_MAX_TOKENS=256000
QWEN_TEMPERATURE=0.7

# Ollama Configuration (for local models)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# LLM Proxy Configuration
USE_LLM_PROXY=false
LLM_PROXY_URL=http://localhost:8001
QWEN_PROXY_ENABLED=false

# Local Qwen via Ollama
QWEN_USE_LOCAL=false  # Set to true to use local Ollama model instead of API
OLLAMA_HOST=http://localhost:11434  # Ollama server URL
OLLAMA_PATH=/Users/username/.ollama  # Path to Ollama models directory
QWEN_LOCAL_MODEL=qwen2.5-coder:7b  # Default local model to use
LOG_DIR=./logs

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
SESSION_SECRET=your-session-secret

# Email (Development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@maifarm.local

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB

# API Keys (for integrations)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=

# Feature Flags
ENABLE_GO_WILD=true
ENABLE_MONITORING=true
ENABLE_OFFLINE_MODE=true
ENABLE_HIGH_AVAILABILITY=false

# Performance
CACHE_TTL=3600
WORKER_THREADS=4
MAX_CONCURRENT_FARMS=10

# Development
HOT_RELOAD=true
DEBUG_SQL=false
MOCK_EXTERNAL_APIS=true