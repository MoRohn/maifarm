# MaiFarm Environment Configuration Template
# Copy this file to .env.development, .env.staging, or .env.production

# Application
NODE_ENV=development
PORT=4567
VITE_API_URL=http://localhost:4567
VITE_WS_URL=ws://localhost:4567

# Authentication
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=7d
BYPASS_AUTH=false

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4567/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4567/api/auth/github/callback

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maifarm
DB_USER=maifarm
DB_PASSWORD=maifarm_password
DB_POOL_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# WebSocket
WS_PORT=4567
WS_PATH=/socket.io

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# AI Providers
AI_PROVIDER=claude # Options: claude, openai

# Claude Configuration
# IMPORTANT: Add your Anthropic API key here for Claude agents to work
# Get your API key from: https://console.anthropic.com/account/keys
CLAUDE_API_KEY=
# Alternative: You can also use ANTHROPIC_API_KEY instead of CLAUDE_API_KEY
CLAUDE_API_ENDPOINT=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-3-sonnet-20240229

# OpenAI GPT-4 Configuration
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_ORG_ID=
OPENAI_TOP_P=0.9
OPENAI_FREQUENCY_PENALTY=0
OPENAI_PRESENCE_PENALTY=0
OPENAI_TIMEOUT=60000
OPENAI_MAX_RETRIES=3

# OpenAI Context Management
OPENAI_MAX_CONTEXT=128000
OPENAI_PRESERVE_SYSTEM=true
OPENAI_SUMMARIZATION_THRESHOLD=100000
OPENAI_SLIDING_WINDOW=64000
OPENAI_RESET_CONTEXT=true

# OpenAI Rate Limiting
OPENAI_RPM=60
OPENAI_TPM=90000
OPENAI_TPD=1000000
OPENAI_CONCURRENT=10

# OpenAI Budget Controls
OPENAI_DAILY_BUDGET=100
OPENAI_MONTHLY_BUDGET=2000
OPENAI_TASK_BUDGET=10
OPENAI_BUDGET_WARNING=0.8
OPENAI_AUTO_SHUTDOWN=false

# OpenAI Privacy & Security
OPENAI_ANONYMIZE=false
OPENAI_PRIVACY_PATTERNS=password,secret,key,token,credential
OPENAI_ENCRYPT=true
OPENAI_RETENTION_DAYS=30
OPENAI_AUDIT_LOG=true

# Ollama Configuration (for local models - not currently supported)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=


# LLM Proxy Configuration
USE_LLM_PROXY=false
LLM_PROXY_URL=http://localhost:8001
LLM_PROXY_PORT=8001
LOG_DIR=./logs

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100
SESSION_SECRET=your-session-secret

# Email (Development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@maifarm.local

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB


# API Keys (for integrations)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=

# XenoSync Configuration
# XenoSync is the primary orchestration engine for multi-agent coordination
USE_XENOSYNC=true
XENOSYNC_MIN_AGENTS=2
XENOSYNC_DEFAULT_MODE=parallel # Options: parallel, collaborative
XENOSYNC_ENABLED=true # Master switch for XenoSync
GO_WILD_USE_XENOSYNC=true # Use XenoSync for Go Wild mode

# Feature Flags
ENABLE_GO_WILD=true
ENABLE_MONITORING=true
ENABLE_OFFLINE_MODE=true
ENABLE_HIGH_AVAILABILITY=false

# Performance
CACHE_TTL=3600
WORKER_THREADS=4
MAX_CONCURRENT_FARMS=10

# Development
HOT_RELOAD=true
DEBUG_SQL=false
MOCK_EXTERNAL_APIS=true
# Orchestrator Service
ORCHESTRATOR_DATABASE_URL=sqlite:///./maifarm.db
ORCHESTRATOR_ALLOWED_ORIGINS=http://localhost:5173
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_TMUX_BIN=/usr/bin/tmux
ORCHESTRATOR_CLAUDE_API_KEY=
ORCHESTRATOR_REDIS_URL=redis://redis:6379/0
