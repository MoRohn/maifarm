# MaiFarm Environment Configuration

# Server Configuration
PORT=4567
NODE_ENV=development
APP_VERSION=2.5.0

# Authentication - Apple Sign-In (iOS Primary)
# Your iOS app bundle identifier(s) - comma-separated for multiple environments
APPLE_APP_BUNDLE_ID=com.maifarm.ios
# APPLE_APP_BUNDLE_IDS=com.maifarm.ios,com.maifarm.ios.dev

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production
REFRESH_SECRET=change-this-to-another-secure-random-string

# Development Authentication (REMOVE IN PRODUCTION)
# Set to 'true' to skip login for local development
BYPASS_AUTH=false
VITE_BYPASS_AUTH=false

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maifarm_dev
DB_USER=maifarm
DB_PASSWORD=maifarm123

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Provider Configuration
AI_PROVIDER=claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-sonnet-20240229

# LLM Proxy (Optional)
USE_LLM_PROXY=false
LLM_PROXY_URL=http://localhost:8001

# Runtime Paths (shared by Node + Python orchestrator)
MAIBARN_ROOT=./maibarn
MAIFARM_WORKSPACE=./maibarn/workspaces

# Orchestrator Agent Defaults
NODE_MEMORY_PER_AGENT=1024

# Logging Configuration (Production-Grade)
LOG_LEVEL=DEBUG
LOG_FORMAT=compact
LOG_CONSOLE=true
LOG_FILE=false
LOG_DIR=./logs
LOG_MAX_FILE_SIZE=10485760
LOG_MAX_FILES=10
LOG_COLORIZE=true
LOG_MASK_SENSITIVE=false

# API Key Encryption
API_KEY_ENCRYPTION_KEY=your-encryption-key-here

# Optional: OpenAI Configuration
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_MAX_CONTEXT=128000

# GPT-OSS Local AI Engine (OpenAI's Open-Source Models)
# No API key needed! Free & private local AI
GPT_OSS_ENABLED=true
GPT_OSS_HOST=http://localhost:8000/v1
GPT_OSS_MODEL=openai/gpt-oss-20b              # 21B params (recommended)
# GPT_OSS_MODEL=openai/gpt-oss-120b          # 117B params (advanced)
GPT_OSS_BACKEND=auto                           # auto, vllm, llama-cpp, or embedded mini fallback
GPT_OSS_PORT=8000
GPT_OSS_MAX_TOKENS=8192
GPT_OSS_TEMPERATURE=0.6
GPT_OSS_CONTEXT_WINDOW=131072
# Allow embedded mini backend fallback for environments without model backends
GPT_OSS_ALLOW_MOCK=false

# For llama-cpp backend (GGUF format)
# GPT_OSS_MODEL_PATH=/path/to/gpt-oss-20b.gguf

# For vLLM backend (GPU memory)
GPT_OSS_GPU_MEMORY=0.9
