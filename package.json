  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --config apps/dashboard/vite.config.ts",
    "dev:server": "NODE_ENV=development BYPASS_AUTH=true PORT=4567 NODE_OPTIONS=--max-old-space-size=8192 tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/index.ts",
    "dev:reset": "rm -rf node_modules/.vite dist && npm run dev",
    "build": "vite build --config apps/dashboard/vite.config.ts",
    "build:check": "npm run typecheck && npm run build",
    "preview": "vite preview --config apps/dashboard/vite.config.ts",
    "test": "jest --config tools/testing/jest.config.cjs",
    "test:unit": "jest --config tools/testing/jest.config.cjs --testPathPattern=src",
    "test:integration": "jest --config tools/testing/jest.config.cjs --testPathPattern=tests/integration",
    "test:server": "jest --config tools/testing/jest.config.server.cjs",
    "test:barn": "jest --config tools/testing/jest.config.server.cjs --testPathPattern=barn",
    "test:barn:integration": "RUN_INTEGRATION_TESTS=true jest --config tools/testing/jest.config.server.cjs --testPathPattern=barn.integration",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:coverage": "jest --config tools/testing/jest.config.cjs --coverage",
    "test:watch": "jest --config tools/testing/jest.config.cjs --watch",
    "lint": "eslint apps/dashboard/src apps/api/src apps/shared --ext ts,tsx,js --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"{apps/dashboard/src,apps/api/src,apps/shared}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{apps/dashboard/src,apps/api/src,apps/shared}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "analyze": "vite build --config apps/dashboard/vite.config.ts --mode analyze",
    "docker:build": "docker build -f ops/config/docker/Dockerfile -t maifarm:latest .",
    "docker:build:prod": "docker build -f ops/config/docker/Dockerfile.production -t maifarm:production .",
    "start": "./scripts/startup.sh",
    "setup:xenosync": "./scripts/install-xenosync.sh",
    "start:prod": "NODE_ENV=production node --max-old-space-size=4096 dist/api/index.js",
    "start:dev": "./scripts/startup.sh",
    "build:prod": "npm run clean && npm run build:server && npm run build:client",
    "build:server": "tsc -p apps/api/tsconfig.json",
    "build:client": "vite build --config apps/dashboard/vite.config.ts --mode production",
    "clean": "rm -rf dist build",
    "migrate:prod": "NODE_ENV=production tsx --tsconfig apps/api/tsconfig.json apps/api/src/database/migrationRunner.ts",
    "health:check": "./scripts/production-readiness-check.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:prod:build": "docker build -f ops/docker/Dockerfile.production -t maifarm:production .",
    "docker:prod:up": "docker-compose -f ops/docker/docker-compose.production.yml up -d",
    "docker:prod:down": "docker-compose -f ops/docker/docker-compose.production.yml down",
    "docker:prod:logs": "docker-compose -f ops/docker/docker-compose.production.yml logs -f",
    "db:health": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database/health-check.ts",
    "db:health:fix": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database/health-check.ts --fix",
    "db:fix": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database/fix-database.ts",
    "db:fix:validate": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database/fix-database.ts --validate",
    "db:fix:restore": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/database/fix-database.ts --restore",
    "docker:logs": "docker-compose logs -f",
    "db:migrate": "echo 'Database migrations handled automatically on startup'",
    "deploy:staging": "./scripts/deploy.sh staging",
    "deploy:production": "./scripts/deploy.sh production",
    "rollback": "./scripts/rollback.sh",
    "perf:test": "./scripts/performance-test.js",
    "perf:lighthouse": "lhci autorun --config=tools/config/lighthouse.config.js",
    "perf:k6": "k6 run tests/performance/k6-load.js",
    "test:providers": "jest --config tools/testing/jest.config.cjs tests/integration/openai-*.test.ts",
    "test:openai": "node scripts/test-openai-connection.js",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:accessibility": "jest --testMatch='**/*.a11y.test.ts'",
    "test:visual": "percy exec -- cypress run",
    "test:performance": "lighthouse http://localhost:4173 --output html --output-path ./reports/lighthouse.html",
    "proxy:stop": "kill -9 $(lsof -t -i:8001) 2>/dev/null || echo 'No proxy server running'",
    "gptoss:farm": "AI_PROVIDER=gpt_oss python orchestrator.py",
    "test:bundle": "npm run build && npx webpack-bundle-analyzer dist/dashboard/assets/*.js",
    "test:security": "npm audit && eslint . --ext .ts,.tsx -c .eslintrc.security.js",
    "test:memory": "jest --testMatch='**/*.memory.test.ts' --detectOpenHandles --forceExit",
    "test:api:load": "k6 run tests/performance/api-load.js",
    "test:critical-path": "cypress run --spec 'cypress/e2e/critical-path/**/*'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "test-storybook",
    "setup": "./scripts/setup-all.sh",
    "setup:all": "./scripts/setup-all.sh",
    "setup:postgres": "./scripts/setup-postgres.sh",
    "setup:doctor": "./scripts/setup-doctor.sh",
    "setup:clean": "./scripts/setup-clean.sh",
    "setup:verify": "./scripts/setup-doctor.sh",
    "postinstall": "npm run setup:verify || echo 'Run npm run setup:all for first-time setup'"
  },
