# ─────────────────────────────────────────────────────────────
# Dependencies & build output
# ─────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
storybook-static/
*.tsbuildinfo
# Stray tsc output next to shared TypeScript sources
apps/shared/**/*.js
apps/shared/**/*.js.map
apps/shared/**/*.d.ts

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
.benchmarks/
.profiling/

# ─────────────────────────────────────────────────────────────
# Environment & secrets (commit templates only: .env.example)
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.template
!.env.docker
*.local
*.pem
!ops/deployment/nginx/ssl/*.pem

# ─────────────────────────────────────────────────────────────
# Runtime data (farm outputs, logs, local databases)
# ─────────────────────────────────────────────────────────────
/var/
/logs/
/maibarn/
/xsync-sessions/
/tmux/
/run/
data/logs/
data/storage/barn/items/*
data/storage/maibarn/harvests/*
data/storage/maibarn/workspaces/*
data/storage/maibarn/terminals/*
data/storage/maibarn/coordination/*
data/uploads/*
data/reports/*
!data/**/.gitkeep
.maifarm_cache/
.xenosync_coordination/
.xenosync_session
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.log
*.pid
ops/config/yaml-templates/

# ─────────────────────────────────────────────────────────────
# Tests & coverage
# ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
cypress/screenshots/
cypress/videos/
tests/**/results/

# ─────────────────────────────────────────────────────────────
# Demo recordings & media (keep large binaries out of git)
# ─────────────────────────────────────────────────────────────
*.mov
*.mp4
*.webm
/demo_videos/
/demo-videos/
/demo-output/
/artifacts/
/screenshots/
ios/demo_frames/
ios/demo_screenshots/
ios/demo_sequence/

# ─────────────────────────────────────────────────────────────
# iOS / Xcode
# ─────────────────────────────────────────────────────────────
ios/build/
ios/DerivedData/
ios/AppStoreConnect/
ios/App/Pods/
# Generated by `npx cap sync`
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/capacitor-cordova-ios-plugins/
xcuserdata/
*.xcuserstate

# ─────────────────────────────────────────────────────────────
# Nested plugin checkouts (managed by scripts/maintenance/update-blerbz-plugins.sh)
# ─────────────────────────────────────────────────────────────
/blerbz-plugins/
/plugins/inference-continuez/
/tools/inference-confidenz/

# ─────────────────────────────────────────────────────────────
# AI assistant & local tooling state
# ─────────────────────────────────────────────────────────────
.claude/*
!.claude/agents/
.ralph-loop-state.json

# ─────────────────────────────────────────────────────────────
# Editors & OS
# ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─────────────────────────────────────────────────────────────
# Backups & scratch files
# ─────────────────────────────────────────────────────────────
*.backup
*.backup.*
*.bak
*.old
*.orig
*.tmp
*.temp
*.deprecated
*.skip
tmp-*.ts
tmp-*.js

# ─────────────────────────────────────────────────────────────
