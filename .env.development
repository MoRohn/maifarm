# MaiFarm Development Environment Configuration

# Application
PORT=4567
VITE_API_URL=http://localhost:4567
VITE_WS_URL=ws://localhost:4567

# Node.js Memory Configuration (8GB for main server process)
NODE_OPTIONS=--max-old-space-size=8192

# Authentication
JWT_SECRET=maifarm-dev-secret-key
JWT_EXPIRY=7d
BYPASS_AUTH=true

# Database (PostgreSQL - will fallback to in-memory if not available)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maifarm_dev
DB_USER=maifarm
DB_PASSWORD=maifarm123
DB_POOL_SIZE=20

# Redis (Optional - will work without it)
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave REDIS_PASSWORD empty for development without auth
REDIS_PASSWORD=
REDIS_DB=0

# WebSocket
WS_PORT=4567
WS_PATH=/socket.io

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,file://
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=10000
SESSION_SECRET=dev-session-secret

# XenoSync Configuration
# XenoSync is the primary orchestration engine for multi-agent coordination
USE_XENOSYNC=true
XENOSYNC_MIN_AGENTS=2
XENOSYNC_DEFAULT_MODE=parallel # Options: parallel, collaborative
XENOSYNC_ENABLED=true # Master switch for XenoSync
GO_WILD_USE_XENOSYNC=true # Use XenoSync for Go Wild mode

# Feature Flags
ENABLE_GO_WILD=true
ENABLE_MONITORING=true
ENABLE_OFFLINE_MODE=true

# AI Provider Configuration
AI_PROVIDER=claude # Options: claude, openai

# Claude/Anthropic Configuration (Auto-added from Settings)
ANTHROPIC_API_KEY=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
CLAUDE_API_KEY=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

# OpenAI Configuration
OPENAI_ENABLED=true
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=128000
OPENAI_TEMPERATURE=0.7
OPENAI_ORG_ID=

# LLM Proxy Configuration
USE_LLM_PROXY=true
LLM_PROXY_URL=http://localhost:8001

