# MaiFarm Development Environment Configuration

# Application
PORT=4567
VITE_API_URL=http://localhost:4567
VITE_WS_URL=ws://localhost:4567

# Authentication
JWT_SECRET=maifarm-dev-secret-key
JWT_EXPIRY=7d
BYPASS_AUTH=true

# Database (PostgreSQL - will fallback to in-memory if not available)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maifarm_dev
DB_USER=maifarm
DB_PASSWORD=maifarm123
DB_POOL_SIZE=20

# Redis (Optional - will work without it)
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave REDIS_PASSWORD empty for development without auth
REDIS_PASSWORD=
REDIS_DB=0

# WebSocket
WS_PORT=4567
WS_PATH=/socket.io

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=1000
SESSION_SECRET=dev-session-secret

# Feature Flags
ENABLE_GO_WILD=true
ENABLE_MONITORING=true
ENABLE_OFFLINE_MODE=true

# AI Provider Configuration
AI_PROVIDER=claude
QWEN_ENABLED=true
QWEN_API_KEY=test-api-key
QWEN_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen-coder-480b
QWEN_MAX_TOKENS=256000
QWEN_TEMPERATURE=0.7
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# LLM Proxy Configuration
USE_LLM_PROXY=false
LLM_PROXY_URL=http://localhost:8001