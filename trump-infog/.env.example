# Application Configuration
NODE_ENV=development
PORT=4567
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:4567

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trump_infog_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_CONNECTION_POOL_SIZE=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BYPASS_AUTH=true

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:3000
SOCKET_PATH=/socket.io

# AI Provider Configuration
AI_PROVIDER=claude
CLAUDE_API_KEY=your-claude-api-key
QWEN_API_KEY=your-qwen-api-key
QWEN_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1
QWEN_MODEL=qwen-coder-480b

# Multi-Agent Configuration
MAX_AGENTS=5
AGENT_TIMEOUT=300000
COORDINATION_PATH=/tmp/claude_coordination
AGENT_WORK_DIR=/tmp/trump_infog_agents

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/svg+xml,application/json,text/csv
UPLOAD_DIR=./uploads

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=./logs

# Monitoring
PROMETHEUS_PORT=9090
METRICS_ENABLED=true
TRACING_ENABLED=false

# External APIs
NEWS_API_KEY=your-news-api-key
DATA_GOV_API_KEY=your-data-gov-api-key

# Feature Flags
ENABLE_CACHE=true
ENABLE_RATE_LIMITING=true
ENABLE_WEBSOCKETS=true
ENABLE_MULTI_AGENT=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=http://localhost:3000
HELMET_CSP_DIRECTIVES=default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'
SESSION_SECRET=your-session-secret-change-in-production

# Development
BYPASS_AUTH=true
MOCK_DATA=false
HOT_RELOAD=true